<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="group_inventory_portal_worker" model="res.groups">
            <field name="name">Inventory Mobile Worker</field>
            <field name="category_id" ref="base.module_category_inventory_inventory"/>
            <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
        </record>

        <record id="stock_picking_portal_company_rule" model="ir.rule">
            <field name="name">Portal Worker Company Rule</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('smart_inventory.group_inventory_portal_worker'))]"/>
        </record>
    </data>
</odoo>