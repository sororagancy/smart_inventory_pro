<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="mobile_app_template" name="Warehouse Mobile App">
        <t t-call="web.layout">
            <t t-set="head">
                <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"/>
                <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"/>
                <script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>
                <script src="/smart_inventory/static/src/js/portal_offline_sync.js?v=6" type="text/javascript"></script>
                <t t-call-assets="smart_inventory.portal_assets" t-js="false"/>
                
                <style>
                    .d-none { display: none !important; }
                    body { background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%); color: #fff; height: 100vh; overflow: hidden; margin: 0; padding: 0; }
                    .app-container { display: flex; flex-direction: column; height: 100vh; padding: 10px; position: relative; }
                    
                    /* الكاميرا الثابتة */
                    .top-camera-section { flex: 0 0 35%; position: relative; border-radius: 15px; overflow: hidden; box-shadow: 0 4px 10px rgba(0,0,0,0.3); margin-bottom: 15px; background: #000; }
                    .bottom-content-section { flex: 1; overflow-y: auto; padding-bottom: 20px; }
                    
                    /* التعديل: الخط الأصفر و شاشة التوقف */
                    .scan-pause-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.4); z-index: 50; display: flex; justify-content: flex-end; flex-direction: column; }
                    .progress-bar-container { width: 100%; background: transparent; height: 8px; overflow: hidden; }
                    .progress-bar-inner { height: 100%; background: #FFC107; width: 0%; box-shadow: 0 0 10px #FFC107; } /* خط أصفر مشع */
                    
                    /* إشعار سريع (Toast) */
                    .toast-notify { position: absolute; top: 10px; left: 10%; width: 80%; background: rgba(76, 175, 80, 0.9); color: white; text-align: center; padding: 8px; border-radius: 20px; z-index: 999; font-weight: bold; font-size: 14px; opacity: 0; transition: opacity 0.3s; pointer-events: none; }
                </style>
            </t>
            
            <div class="app-container" t-att-data-scan-mode="scan_mode" t-att-data-vibrate="vibrate_enabled">
                
                <!-- الإشعار السريع -->
                <div id="quick-toast" class="toast-notify">تم المسح</div>

                <!-- الكاميرا -->
                <div class="top-camera-section">
                    <div id="reader" style="width: 100%; height: 100%;"></div>
                    <div id="scan-overlay" class="scan-pause-overlay d-none">
                        <!-- الخط الأصفر في أسفل الكاميرا -->
                        <div id="timer-ui" class="progress-bar-container d-none">
                            <div id="scan-progress-inner" class="progress-bar-inner"></div>
                        </div>
                        <!-- زر التالي وضع اليدوي يظهر في المنتصف -->
                        <div id="next-btn-ui" class="d-none w-100 text-center mb-5">
                            <button class="btn btn-lg btn-warning text-dark" onclick="window.resumeScanning()" style="border-radius: 30px; font-weight:bold; padding: 10px 40px;">مسحة جديدة</button>
                        </div>
                    </div>
                </div>

                <div class="bottom-content-section glass-panel">
                    
                    <!-- 1. الرئيسية -->
                    <div id="view-home">
                        <div class="action-buttons">
                            <button class="glass-btn btn-blue" onclick="window.loadOperations('receipt')">استلام <span id="badge-receipt" class="badge bg-light text-dark float-end">-</span></button>
                            <button class="glass-btn btn-red" onclick="window.loadOperations('delivery')">توصيل <span id="badge-delivery" class="badge bg-light text-dark float-end">-</span></button>
                            <button class="glass-btn btn-yellow" onclick="window.showCreateReturn()">إنشاء مرتجع <span id="badge-return" class="badge bg-light text-dark float-end">-</span></button>
                            <button class="glass-btn btn-green" onclick="window.loadOperations('internal')">تحويل داخلي <span id="badge-internal" class="badge bg-light text-dark float-end">-</span></button>
                            <button class="glass-btn btn-dark" onclick="window.showCreateInventory()">جرد جديد (مستمر)</button>
                        </div>
                    </div>

                    <!-- 2. قائمة العمليات -->
                    <div id="view-ops-list" class="d-none">
                        <h5 class="border-bottom pb-2 mb-3">العمليات المتاحة</h5>
                        <div id="ops-list-content"></div>
                    </div>

                    <!-- 3. تفاصيل الحركة (استلام/توصيل) -->
                    <div id="view-picking-detail" class="d-none">
                        <h5 id="page-title" class="border-bottom pb-2 mb-3" style="font-weight:bold;">العملية</h5>
                        <div id="picking-detail-content"></div>
                    </div>

                    <!-- 4. إنشاء مرتجع -->
                    <div id="view-create-return" class="d-none">
                        <h5 class="border-bottom pb-2 mb-3">إنشاء عملية مرتجع</h5>
                        <label>نوع المرتجع:</label>
                        <select id="ret-type" class="form-select mb-3"><option value="sales">مرتجع بيع (من عميل للمخزن)</option><option value="purchase">مرتجع شراء (من المخزن لمورد)</option></select>
                        <label>العميل / المورد:</label>
                        <select id="ret-partner" class="form-select mb-3"></select>
                        <label>المخزن (الداخلي):</label>
                        <select id="ret-location" class="form-select mb-4"></select>
                        <button class="btn btn-warning w-100" onclick="window.createReturnProcess()">إنشاء وبدء الجرد</button>
                    </div>

                    <!-- 5. إنشاء جرد / الجرد المستمر -->
                    <div id="view-inventory" class="d-none">
                        <h5 class="border-bottom pb-2 mb-3">الجرد المستمر (Cycle Count)</h5>
                        <div id="inv-setup">
                            <label>اختر المخزن للجرد:</label>
                            <select id="inv-location" class="form-select mb-4"></select>
                            <button class="btn btn-dark w-100" onclick="window.startInventory()">بدء الجرد</button>
                        </div>
                        <div id="inv-active" class="d-none">
                            <p class="text-info text-center" style="font-size:12px;">المسح مستمر... قم بمسح المنتجات تباعاً.</p>
                            <div id="inv-lines" style="max-height:30vh; overflow-y:auto;"></div>
                            <div class="d-flex mt-3 gap-2">
                                <button class="btn btn-outline-light w-50" onclick="window.saveInventoryCount(false)">حفظ التقدم</button>
                                <button class="btn btn-success w-50" onclick="window.saveInventoryCount(true)">اعتماد الجرد</button>
                            </div>
                        </div>
                    </div>
                    
                </div>
            </div>
        </t>
    </template>
</odoo>