<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_smart_inventory" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.smart.inventory</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='barcode_setting_container']" position="after">
                <block title="Smart Inventory Mobile App" name="smart_inventory_app_setting_container">
                    <setting string="Strict Barcode Validation" help="Prevent manual quantity entry.">
                        <field name="smart_inventory_strict_barcode"/>
                    </setting>
                    <setting string="Scan Pause Mode" help="طريقة إيقاف الكاميرا بعد كل قراءة.">
                        <field name="smart_inventory_scan_mode" widget="radio"/>
                    </setting>
                    <setting string="تفعيل الاهتزاز" help="اهتزاز الهاتف عند المسح.">
                        <field name="smart_inventory_vibration" widget="boolean_toggle"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>